{
  "driver_pocketvr": {
    "connection.mode": "auto",
    "connection.control_port": 9943,
    "connection.media_port": 9944,
    "video.codec": "auto",
    "video.preset": "balanced",
    "video.fps": 60,
    "video.resolution": "auto",
    "video.render_scale": 1,
    "video.bitrate_mbps": 60,
    "video.min_bitrate_mbps": 15,
    "video.max_bitrate_mbps": 120,
    "video.adaptive": true,
    "video.slices": 2,
    "video.send_spread_pct": 60,
    "fec.adaptive": true,
    "fec.ratio_pct": 10,
    "display.ipd_mm": 63.9,
    "display.fov_scale": 1,
    "display.eye_size": 1.35,
    "display.vignette_strength": 0.3,
    "display.vignette_size": 0.85,
    "display.vignette_softness": 0.25,
    "display.vignette_dynamic": false,
    "display.chromatic_correction": false,
    "display.edge_mode": "black",
    "lens.profile": "generic_cardboard_v2",
    "lens.distortion_tweak": 0,
    "lens.k1": 0.34,
    "lens.k2": 0.55,
    "lens.screen_to_lens_m": 0.039,
    "lens.inter_lens_distance_m": 0.0639,
    "lens.screen_width_m": 0.134,
    "lens.screen_height_m": 0.062,
    "lens.vertical_offset_m": 0,
    "lens.fov_left_deg": 89,
    "lens.fov_right_deg": 89,
    "lens.fov_bottom_deg": 89,
    "lens.fov_top_deg": 89,
    "tracking.fusion": "gyro_accel",
    "tracking.rate_hz": 400,
    "tracking.yaw_correction": "slow_autocenter",
    "tracking.max_prediction_ms": 80,
    "tracking.prediction_ms": "auto",
    "tracking.eye_height_m": 1.65,
    "reprojection.enabled": true,
    "pacing.target_lead_ms": 4,
    "input.mapping": "xbox",
    "input.recenter_hotkey": "Ctrl+Alt+R",
    "input.bind_a": "left_pad",
    "input.bind_b": "right_pad",
    "input.bind_x": "left_menu",
    "input.bind_y": "right_menu",
    "input.bind_left_bumper": "left_grip",
    "input.bind_right_bumper": "right_grip",
    "input.bind_left_stick": "left_pad",
    "input.bind_right_stick": "right_pad",
    "input.bind_start": "system",
    "input.bind_select": "recenter",
    "input.bind_volume_up": "right_trigger",
    "input.bind_volume_down": "right_grip",
    "input.bind_touch_left": "left_trigger",
    "input.bind_touch_right": "right_trigger",
    "input.bind_touch_menu": "system",
    "input.bind_recenter": "recenter",
    "ui.stats_overlay": "off",
    "power.keep_awake": true,
    "power.thermal_guard": true,
    "security.encrypt_media": true,
    "debug.log_level": "info",
    "debug.dump_frames": false,
    "debug.latency_log": false,
    "debug.test_pattern": false,
    "enable": true
  }
}
