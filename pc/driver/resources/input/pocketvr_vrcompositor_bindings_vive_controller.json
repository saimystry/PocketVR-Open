{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "openvr.component.vrcompositor",
  "bindings": {
    "/actions/system": {
      "chords": [
        {
          "inputs": [
            [
              "/user/hand/left/input/system",
              "held"
            ],
            [
              "/user/hand/right/input/trigger",
              "click"
            ]
          ],
          "output": "/actions/system/in/TakeScreenshot"
        },
        {
          "inputs": [
            [
              "/user/hand/right/input/system",
              "held"
            ],
            [
              "/user/hand/left/input/trigger",
              "click"
            ]
          ],
          "output": "/actions/system/in/TakeScreenshot"
        }
      ],
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/system/in/ToggleDashboard"
            },
            "double": {
              "output": "/actions/system/in/ToggleRoomView"
            },
            "held": {
              "output": "/actions/system/in/SystemButtonChord"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/system"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/system/in/ToggleDashboard"
            },
            "double": {
              "output": "/actions/system/in/ToggleRoomView"
            },
            "held": {
              "output": "/actions/system/in/SystemButtonChord"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/system"
        }
      ]
    },
    "/actions/lasermouse": {
      "haptics": [
        {
          "output": "/actions/lasermouse/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/lasermouse/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/lasermouse/in/Pointer",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/lasermouse/in/Pointer",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/leftclick"
            }
          },
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.5",
            "click_deactivate_threshold": "0.45",
            "off_haptic_amplitude": "0"
          },
          "path": "/user/hand/left/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/leftclick"
            }
          },
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.5",
            "click_deactivate_threshold": "0.45",
            "off_haptic_amplitude": "0"
          },
          "path": "/user/hand/right/input/trigger"
        }
      ]
    },
    "/actions/quickrecenter": {
      "sources": [
        {
          "inputs": {
            "long": {
              "output": "/actions/quickrecenter/in/Recenter"
            }
          },
          "mode": "button",
          "parameters": {
            "long_press_delay": 1.0,
            "long_press_expiry": 4.0
          },
          "path": "/user/hand/left/input/system"
        },
        {
          "inputs": {
            "long": {
              "output": "/actions/quickrecenter/in/Recenter"
            }
          },
          "mode": "button",
          "parameters": {
            "long_press_delay": 1.0,
            "long_press_expiry": 4.0
          },
          "path": "/user/hand/right/input/system"
        }
      ]
    }
  },
  "category": "steamvr_input",
  "controller_type": "vive_controller",
  "description": "PocketVR desktop controller bindings for the SteamVR dashboard and compositor.",
  "name": "Default VR Dashboard bindings for PocketVR controllers",
  "options": {},
  "simulated_actions": []
}
