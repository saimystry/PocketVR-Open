{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "condition": {
        "type": "allOf",
        "conditions": [
          {"type": "notEquals", "lhs": "$env{POCKETVR_BUILD_ROOT}", "rhs": ""},
          {"type": "notEquals", "lhs": "$env{VCPKG_ROOT}", "rhs": ""}
        ]
      },
      "generator": "Ninja",
      "binaryDir": "$env{POCKETVR_BUILD_ROOT}/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "$env{POCKETVR_BUILD_ROOT}/vcpkg-installed",
        "POCKETVR_SDK_ROOT": "$env{POCKETVR_BUILD_ROOT}/sdks",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-debug",
      "binaryDir": "$env{POCKETVR_BUILD_ROOT}/windows-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}}
  ]
}
